# Safe-to-share key used for public storefront reads. Register your site origin
# (and http://localhost:6543 while developing) in FrontDesk → Developers.
FRONTDESK_PUBLISHABLE_KEY=fd_pk_test_replace_me

# Secret key. Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
FRONTDESK_SECRET_KEY=fd_sk_test_replace_me

# Per-destination signing secret shown after creating the webhook in Frontdesk.
FRONTDESK_WEBHOOK_SECRET=replace_with_frontdesk_destination_secret

# Keep true while designing with local preview products. Change to false when
# the Ahumma workspace keys above are ready.
FRONTDESK_PREVIEW_ONLY=true

# The deployed website URL. FrontDesk returns buyers here after payment.
NEXT_PUBLIC_SITE_URL=http://localhost:6543

# Optional brand overrides.
NEXT_PUBLIC_SITE_NAME=AHUMMA
NEXT_PUBLIC_SUPPORT_EMAIL=hello@ahumma.com
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ahummabeauty

# The official API base already includes /v1.
FRONTDESK_API_BASE_URL=https://api.frontdesk.africa/v1
